<Window x:Class="NovaRpHelper.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mod="clr-namespace:NovaRpHelper.Modules"
        Title="Nova RP Helper"
        Width="420"
        Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
                ResizeMode="CanResizeWithGrip"
        MinWidth="360"
        MinHeight="420"
        WindowStartupLocation="Manual"
        Left="100" Top="100">

    <!-- DataContext создается в code-behind (view-first MVVM) -->

    <Border Background="#E61E1E1E" 
            BorderBrush="#3F3F46" 
            BorderThickness="1" 
            CornerRadius="8"
            Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==================== ЗАГОЛОВОК ==================== -->
            <Border Grid.Row="0" 
                    Background="#252526" 
                    CornerRadius="6" 
                    Padding="10,6"
                    Margin="0,0,0,8"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel>
                    <TextBlock Text="⚡ NOVA RP Helper" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="RoleBadge"
                               Text=""
                               FontSize="11"
                               Foreground="#00B4D8"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right">
                        <Button Content="📌" Width="28" Height="28" Margin="4,0,0,0"
                                ToolTip="Закрепить/открепить окно"
                                Click="PinButton_Click"
                                Style="{StaticResource ModernButton}"/>
                        <Button Content="👁" Width="28" Height="28" Margin="4,0,0,0"
                                ToolTip="Скрыть/показать оверлей"
                                Click="ToggleVisibility_Click"
                                Style="{StaticResource ModernButton}"/>
                        <Button Content="✕" Width="28" Height="28" Margin="4,0,0,0"
                                ToolTip="Закрыть"
                                Click="CloseButton_Click"
                                Style="{StaticResource ModernButton}"
                                Background="#F44336"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ==================== TARGET ID ==================== -->
            <Border Grid.Row="1" 
                    Background="#252526" 
                    CornerRadius="6" 
                    Padding="10,6"
                    Margin="0,0,0,8">
                <DockPanel>
                    <TextBlock Text="Target ID:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#B0B0B0"/>
                    <TextBox Text="{Binding TargetId, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             Width="120" HorizontalAlignment="Left"/>
                    <TextBlock Text="🔑 INSERT — режим клика" 
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               Foreground="#B0B0B0" FontSize="11" DockPanel.Dock="Right"/>
                </DockPanel>
            </Border>

            <!-- ==================== СТАТУС-БАР ==================== -->
            <Border Grid.Row="2" 
                    Background="#2D2D30" 
                    CornerRadius="6" 
                    Padding="10,4"
                    Margin="0,0,0,8">
                <DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="#B0B0B0" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <TextBlock Text="{Binding ClickThroughStatus}" Foreground="#00B4D8" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ==================== ВКЛАДКИ ==================== -->
            <TabControl Grid.Row="3" SelectedIndex="{Binding SelectedTabIndex}">

                <!-- ============ ВКЛАДКА 1: БИНДЕР ============ -->
                <TabItem Header="🎯 Биндер">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#252526" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Новый бинд" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Название:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Text="{Binding NewBinderName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}" Width="180" Margin="0,0,0,4"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Горячая клавиша:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Text="{Binding NewBinderHotKey, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}" Width="180" Margin="0,0,0,4"
                                             IsReadOnly="True" PreviewKeyDown="HotKeyCapture_PreviewKeyDown"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Текст:" VerticalAlignment="Top" Margin="0,4,8,0"/>
                                    <TextBox Grid.Row="2" Grid.Column="1"
                                             Text="{Binding NewBinderText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}" Width="180" Height="60"
                                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox Content="Цепочка" IsChecked="{Binding IsChainMode}" Margin="0,0,12,0"/>
                                    <CheckBox Content="Исп. {ID}" IsChecked="{Binding UseTargetId}"/>
                                </StackPanel>

                                <Button Content="+ Добавить бинд" Style="{StaticResource ModernButton}" Margin="0,8,0,0" Click="AddBinder_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="#252526" CornerRadius="6" Padding="8">
                            <ListBox ItemsSource="{Binding Binders}" SelectedItem="{Binding SelectedBinder}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="2">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="▶" Width="26" Height="26" ToolTip="Тест"
                                                        Click="TestBinder_Click" Style="{StaticResource ModernButton}" Background="#4CAF50"/>
                                                <Button Content="✕" Width="26" Height="26" Margin="4,0,0,0" ToolTip="Удалить"
                                                        Click="DeleteBinder_Click" Style="{StaticResource ModernButton}" Background="#F44336"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock>
                                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    <Run Text=" [" Foreground="#B0B0B0"/>
                                                    <Run Text="{Binding HotKey, Mode=OneWay}" Foreground="#00B4D8"/>
                                                    <Run Text="]" Foreground="#B0B0B0"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Text}" Foreground="#B0B0B0" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ============ ВКЛАДКА 2: КОДЕКСЫ И НАКАЗАНИЯ ============ -->
                <TabItem Header="⚖ Кодексы">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#252526" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBox Text="{Binding CodebookSearch, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button Content="Правила" Width="62" Margin="0,0,4,4" Style="{StaticResource ModernButton}" Click="FilterCodebook_Click" Tag="Правила"/>
                                    <Button Content="Гос" Width="44" Margin="0,0,4,4" Style="{StaticResource ModernButton}" Click="FilterCodebook_Click" Tag="Гос"/>
                                    <Button Content="Уставы" Width="56" Margin="0,0,4,4" Style="{StaticResource ModernButton}" Click="FilterCodebook_Click" Tag="Уставы"/>
                                    <Button Content="Мероприятия" Width="88" Margin="0,0,4,4" Style="{StaticResource ModernButton}" Click="FilterCodebook_Click" Tag="Мероприятия"/>
                                    <Button Content="Крим" Width="48" Margin="0,0,4,4" Style="{StaticResource ModernButton}" Click="FilterCodebook_Click" Tag="Крим"/>
                                    <Button Content="GZ" Width="40" Margin="0,0,4,4" Style="{StaticResource ModernButton}" Click="FilterCodebook_Click" Tag="GZ"/>
                                    <Button Content="Лидеры" Width="58" Margin="0,0,4,4" Style="{StaticResource ModernButton}" Click="FilterCodebook_Click" Tag="Лидеры"/>
                                    <Button Content="Проверки" Width="68" Margin="0,0,4,4" Style="{StaticResource ModernButton}" Click="FilterCodebook_Click" Tag="Проверки"/>
                                    <Button Content="Команды" Width="68" Margin="0,0,4,4" Style="{StaticResource ModernButton}" Click="FilterCodebook_Click" Tag="Команды"/>
                                    <Button Content="УК" Width="40" Margin="0,0,4,4" Style="{StaticResource ModernButton}" Click="FilterCodebook_Click" Tag="УК"/>
                                    <Button Content="АК" Width="40" Margin="0,0,4,4" Style="{StaticResource ModernButton}" Click="FilterCodebook_Click" Tag="АК"/>
                                    <Button Content="ДК" Width="40" Margin="0,0,4,4" Style="{StaticResource ModernButton}" Click="FilterCodebook_Click" Tag="ДК"/>
                                    <Button Content="Все" Width="40" Margin="0,0,4,4" Style="{StaticResource ModernButton}" Click="FilterCodebook_Click" Tag=""/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="#252526" CornerRadius="6" Padding="8">
                            <ListBox ItemsSource="{Binding FilteredCodebook}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,2">
                                            <StackPanel>
                                                <TextBlock>
                                                    <Run Text="{Binding Category, Mode=OneWay}" Foreground="#FF9800" FontSize="10"/>
                                                    <Run Text=" " />
                                                    <Run Text="{Binding Article, Mode=OneWay}" FontWeight="SemiBold" Foreground="#00B4D8"/>
                                                    <Run Text=" — " Foreground="#B0B0B0"/>
                                                    <Run Text="{Binding Title, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Description}" Foreground="#B0B0B0" FontSize="11"
                                                           TextWrapping="Wrap" MaxWidth="340"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Foreground="#FF9800" FontSize="11">
                                                        <Run Text="🔒 "/>
                                                        <Run Text="{Binding JailMinutes, Mode=OneWay}"/>
                                                        <Run Text=" мин"/>
                                                    </TextBlock>
                                                    <TextBlock Foreground="#4CAF50" FontSize="11" Margin="12,0,0,0">
                                                        <Run Text="💰 "/>
                                                        <Run Text="{Binding FineAmount, Mode=OneWay}"/>
                                                        <Run Text=" $"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Протокол и выдача наказания -->
                        <Border Grid.Row="2" Background="#2D2D30" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Протокол:" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                        <TextBlock Foreground="#FF9800" Margin="0,0,12,0">
                                            <Run Text="🔒 "/>
                                            <Run Text="{Binding TotalJailMinutes, Mode=OneWay}"/>
                                            <Run Text=" мин"/>
                                        </TextBlock>
                                        <TextBlock Foreground="#4CAF50">
                                            <Run Text="💰 "/>
                                            <Run Text="{Binding TotalFineAmount, Mode=OneWay}"/>
                                            <Run Text=" $"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Content="IC (/jail, /fine)" IsChecked="{Binding IsIcMode}"
                                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Мин:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#B0B0B0" FontSize="11"/>
                                    <TextBox Text="{Binding OverrideMinutes, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}" Width="46" Margin="0,0,8,0"/>
                                    <TextBlock Text="Штраф:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#B0B0B0" FontSize="11"/>
                                    <TextBox Text="{Binding OverrideFine, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}" Width="70"/>
                                </StackPanel>

                                <TextBox Text="{Binding GeneratedCommand, Mode=OneWay}"
                                         Style="{StaticResource ModernTextBox}" IsReadOnly="True"
                                         TextWrapping="Wrap" Margin="0,0,0,6"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="📋 Копировать" Style="{StaticResource ModernButton}" Width="96" Click="CopyCommand_Click"/>
                                    <Button Content="📨 Отправить" Style="{StaticResource ModernButton}" Width="96" Margin="6,0,0,0"
                                            Click="SendCommand_Click" Background="#4CAF50"/>
                                    <Button Content="📝 В журнал" Style="{StaticResource ModernButton}" Width="96" Margin="6,0,0,0"
                                            Command="{Binding RecordPunishmentCommand}" Background="#0078D4"/>
                                    <Button Content="Сброс" Style="{StaticResource ModernButton}" Width="60" Margin="6,0,0,0"
                                            Click="ResetCodebookSelection_Click" Background="#F44336"/>
                                </StackPanel>

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Журнал наказаний" FontSize="11" Foreground="#B0B0B0"/>
                                    <Button Content="🗑" Width="26" Height="24" HorizontalAlignment="Right" DockPanel.Dock="Right"
                                            Command="{Binding ClearPunishmentLogCommand}"
                                            Style="{StaticResource ModernButton}" Background="#3F3F46"/>
                                </DockPanel>
                                <ListBox ItemsSource="{Binding PunishmentLog}" Height="86">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="2">
                                                <TextBlock Text="{Binding When, StringFormat={}{0:dd.MM HH:mm}}"
                                                           Width="78" FontSize="10" Foreground="#808080" VerticalAlignment="Top"/>
                                                <StackPanel>
                                                    <TextBlock FontSize="11">
                                                        <Run Text="{Binding Mode, Mode=OneWay}" FontWeight="SemiBold" Foreground="#00B4D8"/>
                                                        <Run Text=" → " Foreground="#808080"/>
                                                        <Run Text="{Binding TargetId, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text=" | " Foreground="#808080"/>
                                                        <Run Text="{Binding Articles, Mode=OneWay}" Foreground="#B0B0B0"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Text}" FontSize="10" Foreground="#B0B0B0"
                                                               TextWrapping="Wrap" MaxWidth="300"/>
                                                    <TextBlock Text="{Binding IssuedBy}" FontSize="9" Foreground="#606060"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ============ ВКЛАДКА 3: ЖУРНАЛ (личное) ============ -->
                <TabItem Header="📔 Журнал" DataContext="{x:Static mod:JournalModule.Instance}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,8,0,0">

                            <!-- Заметки -->
                            <Border Background="#252526" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Заметки (сделки, долги, контакты)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <DockPanel Margin="0,0,0,6">
                                        <Button Content="+" Width="40" DockPanel.Dock="Right" Margin="6,0,0,0"
                                                Command="{Binding AddNoteCommand}" Style="{StaticResource ModernButton}"/>
                                        <TextBox Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </DockPanel>
                                    <ListBox ItemsSource="{Binding Notes}" Height="110">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="2">
                                                    <Button Content="✕" Width="24" Height="24" DockPanel.Dock="Right"
                                                            Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ModernButton}" Background="#F44336"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="300"/>
                                                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd.MM HH:mm}}"
                                                                   FontSize="10" Foreground="#808080"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <!-- Бухгалтерия -->
                            <Border Background="#252526" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Бухгалтерия смены" FontWeight="SemiBold"/>
                                        <TextBlock Foreground="#00B4D8" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                            <Run Text="Баланс: "/>
                                            <Run Text="{Binding TotalBalance, Mode=OneWay}"/>
                                            <Run Text=" $"/>
                                        </TextBlock>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBox Text="{Binding LedgerAmount, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}" Width="90" Margin="0,0,6,0"/>
                                        <TextBox Text="{Binding LedgerComment, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Content="+ Приход" Width="100" Command="{Binding AddIncomeCommand}"
                                                Style="{StaticResource ModernButton}" Background="#4CAF50"/>
                                        <Button Content="− Расход" Width="100" Margin="8,0,0,0" Command="{Binding AddExpenseCommand}"
                                                Style="{StaticResource ModernButton}" Background="#F44336"/>
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding Ledger}" Height="110">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="2">
                                                    <Button Content="✕" Width="24" Height="24" DockPanel.Dock="Right"
                                                            Command="{Binding DataContext.DeleteLedgerCommand, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ModernButton}" Background="#3F3F46"/>
                                                    <TextBlock Foreground="#808080" FontSize="10" Width="70" DockPanel.Dock="Right"
                                                               Text="{Binding CreatedAt, StringFormat={}{0:dd.MM HH:mm}}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock>
                                                        <Run Text="{Binding Amount, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text=" $ — " Foreground="#B0B0B0"/>
                                                        <Run Text="{Binding Comment, Mode=OneWay}" Foreground="#B0B0B0"/>
                                                    </TextBlock>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <!-- Чек-лист -->
                            <Border Background="#252526" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Чек-лист смены" FontWeight="SemiBold"/>
                                        <Button Content="Сбросить галочки" HorizontalAlignment="Right" DockPanel.Dock="Right"
                                                Command="{Binding ResetChecksCommand}"
                                                Style="{StaticResource ModernButton}" Background="#3F3F46"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <Button Content="+" Width="40" DockPanel.Dock="Right" Margin="6,0,0,0"
                                                Command="{Binding AddCheckCommand}" Style="{StaticResource ModernButton}"/>
                                        <TextBox Text="{Binding NewCheck, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </DockPanel>
                                    <ListBox ItemsSource="{Binding Checklist}" Height="140">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="2">
                                                    <Button Content="✕" Width="24" Height="24" DockPanel.Dock="Right"
                                                            Command="{Binding DataContext.DeleteCheckCommand, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ModernButton}" Background="#3F3F46"/>
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              Content="{Binding Text}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============ ВКЛАДКА 4: ТАЙМЕРЫ И АВТО-ПИАР ============ -->
                <TabItem Header="⏱ Таймеры">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#252526" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Быстрые таймеры" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button Content="🚗 Угон (5 мин)" Style="{StaticResource ModernButton}" Margin="0,0,4,4" Click="StartTimer_Click" Tag="300"/>
                                    <Button Content="💊 Аптечка (3 мин)" Style="{StaticResource ModernButton}" Margin="0,0,4,4" Click="StartTimer_Click" Tag="180"/>
                                    <Button Content="🛡 Броня (10 мин)" Style="{StaticResource ModernButton}" Margin="0,0,4,4" Click="StartTimer_Click" Tag="600"/>
                                    <Button Content="🎣 Капт (15 мин)" Style="{StaticResource ModernButton}" Margin="0,0,4,4" Click="StartTimer_Click" Tag="900"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="#252526" CornerRadius="6" Padding="8">
                            <ListBox ItemsSource="{Binding ActiveTimers}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="2">
                                            <Button Content="✕" Width="26" Height="26" DockPanel.Dock="Right"
                                                    Style="{StaticResource ModernButton}" Background="#F44336" Click="StopTimer_Click"/>
                                            <StackPanel>
                                                <TextBlock><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                                                <TextBlock Foreground="#00B4D8" FontSize="14" FontWeight="Bold">
                                                    <Run Text="{Binding RemainingText, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Border Grid.Row="2" Background="#2D2D30" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <CheckBox Content="Авто-пиар активен" IsChecked="{Binding AutoAdvertEnabled}"
                                              Checked="AutoAdvert_Changed" Unchecked="AutoAdvert_Changed"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                        <TextBlock Text="Интервал (сек):" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B0B0B0"/>
                                        <TextBox Text="{Binding AutoAdvertInterval, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}" Width="60"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBox Text="{Binding AutoAdvertText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,6"/>
                                <CheckBox Content="Рандомизировать окончание (обход анти-спама)" IsChecked="{Binding AutoAdvertRandomize}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>